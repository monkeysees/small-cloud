# Merge inside the management site, preserving its TLS settings and global log filter.
@upload path /api/deploy
handle @upload {
    request_body {
        max_size 121634816
    }
    reverse_proxy 127.0.0.1:8765
}
@identity path /auth/* /directory /api/auth/* /api/workspaces /api/workspaces/* /api/admin/member/add /api/admin/creator/grant /api/apps/* /api/operations /api/operations/* /api/directory /api/usage
handle @identity {
    request_body {
        max_size 16KB
    }
    reverse_proxy 127.0.0.1:8765
}
@landing path / /landing.css
handle @landing {
    root * /srv/small-cloud/landing
    file_server
}
handle {
    respond "Not found" 404
}
