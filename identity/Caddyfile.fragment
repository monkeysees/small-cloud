# Merge inside the management site, preserving its TLS settings and global log filter.
@upload path /api/deploy
handle @upload {
    request_body {
        max_size 121634816
    }
    reverse_proxy 127.0.0.1:8765
}
@identity path /auth/* /api/auth/* /api/admin/member/add /api/admin/creator/grant /api/apps/* /api/operations /api/operations/*
handle @identity {
    request_body {
        max_size 16KB
    }
    reverse_proxy 127.0.0.1:8765
}
handle {
    respond "Small Cloud: publish apps with the small-cloud CLI." 200
}
