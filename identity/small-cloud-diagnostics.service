[Unit]
Description=Small Cloud redacted runtime diagnostics collector
After=network-online.target small-cloud-identity.service
Wants=network-online.target
Requires=small-cloud-identity.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/small-cloud-identity/bin/python -m identity.collector --config /etc/small-cloud/publishing.json
Restart=always
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/small-cloud /run
MemoryMax=256M
TasksMax=16
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
