[Unit]
Description=Small Cloud HTTP idle stop and on-demand start worker
After=network-online.target small-cloud-identity.service
After=small-cloud-diagnostics.service
Wants=network-online.target
Requires=small-cloud-identity.service
PartOf=small-cloud-identity.service
ConditionPathExists=!/etc/small-cloud/maintenance
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=notify
User=root
UMask=0077
ExecStart=/opt/small-cloud-identity/bin/python -m identity.worker --config /etc/small-cloud/publishing.json --lifecycle
ExecStartPre=/opt/small-cloud-identity/bin/python -m identity.services dependencies
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
TimeoutStopSec=2100
KillMode=mixed
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/small-cloud /run
MemoryMax=256M
TasksMax=64
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
